# Node
node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package manager caches
.pnpm-store/
.npm/

# Frontend build outputs
frontend_app/dist/
frontend_app/.wrangler/
frontend_app/.vite/
frontend_app/*.tsbuildinfo
dist/
!demo/dist/
!demo/dist/**

# Rust / Tauri build outputs
desktop/src-tauri/target/
target/
**/target/
desktop/src-tauri/target.release/
desktop/src-tauri/target.debug/

# Tauri bundles and updater artifacts
desktop/src-tauri/bundle/
desktop/src-tauri/gen/
desktop/src-tauri/*.sig

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# Local/personal helper files
*.local
*.tmp
*.bak
*.swp
*.orig
.history/
.cache/
.temp/
tmp/

# Local environment/tooling (keep examples tracked)
.python-version
.venv/
.venv*/
venv/
__pycache__/
*.pyc

# Env files
.env
.env.*
!.env.example

DECISIONS_NEEDED.md
OSS_SCOPE.md
RELEASE_PROCESS.md

# Local-only design planning — not for the public repo
/docs/UI_REWORK_PLAN.md
/docs/ui-mockups/
# Keep developer scripts tracked. Ignore only generated/backup files inside scripts/
/scripts/*.bak*
/scripts/*.tmp
/scripts/*.orig

# Local copilot instructions
.github/copilot-instructions.md
# Linux container build output
/dist-linux

# Snap build input: the deb copied in by hand before `snapcraft`, never committed.
desktop/snap/deb/
desktop/snap/*.snap

# winget manifests: generated per release (wingetcreate) and submitted to
# microsoft/winget-pkgs, which is where they live. A copy here only goes stale.
desktop/winget/

# Store packaging: signing material and built packages never belong here. The
# certificate lives in the Windows certificate store; see desktop/msix/build-msix.ps1.
*.pfx
*.p12
*.cer
*.snk
*.msix
*.msixupload
*.appx
*.appxupload

# This project builds with pnpm -- CI, the deploy workflow and the image build
# all use pnpm-lock.yaml. An npm lockfile alongside it silently rots: the one
# committed here drifted for three months and reported dependency versions
# that were never shipped.
package-lock.json
